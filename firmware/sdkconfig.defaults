# ── AirGuard-S3 · ESP32-S3-DevKitC-1 N16R8 ──
# 🔴 ตั้งผิด = บูตไม่ขึ้น หรือใช้ PSRAM ไม่ได้

CONFIG_IDF_TARGET="esp32s3"

# Flash 16 MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM 8 MB โหมด Octal — R8 ต้องเป็น OCT ไม่ใช่ QUAD
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Partition table เอง (FW-5a) — factory app 4 MB แทน 1 MB ของค่าเริ่มต้น
# เหตุผลของขนาด: firmware/README.md หัวข้อ "partition table"
# ⚠️ sdkconfig เดิมจะไม่รับค่านี้ → ลบ firmware/sdkconfig ก่อน build
#    (main/CMakeLists.txt หยุด build ไว้ถ้ายังเป็น partition เดิม)
# ⚠️ เปลี่ยน partition แล้วต้อง flash เต็ม (idf.py flash) ไม่ใช่ app-flash
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# FreeRTOS — tick 1 ms เพื่อให้จับเวลาแม่นระดับมิลลิวินาที
CONFIG_FREERTOS_HZ=1000

# FAT long file names (FW-4 §8) [ขึ้นกับเวอร์ชัน ESP-IDF]
# ชื่อ AG_YYYYMMDD_HHMMSS.csv (22 ตัว) เกิน 8.3 → ต้องเปิด LFN
# เลือก HEAP: buffer LFN ((MAX_LFN+1)×2 = 512 B) ถูก malloc เฉพาะตอน
# fopen/stat (ครั้งต่อบูต/ต่อวัน/ต่อ event) แทนที่จะกิน stack ของทุก task
# ที่เรียก FatFS → storage task ไม่ต้องเผื่อ 512 B · fragmentation น้อยเพราะ
# จองแล้วคืนทันทีและนานๆ ครั้ง
# ⚠️ sdkconfig เดิมที่มีอยู่แล้วจะไม่รับค่านี้ → ลบ firmware/sdkconfig ก่อน build
#    (tasks_storage.c มี #error ดักไว้)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# เผื่อ log ตอนพัฒนา
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
