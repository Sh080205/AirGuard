/* Copy to secrets.h (same folder) and fill in the phone hotspot.
 * secrets.h is ignored by git (.gitignore: secrets.*) — never commit it.
 * Without secrets.h the firmware still builds; time then comes only from
 * the console command: settime 2026-10-06T09:00:00+07:00 */
#ifndef AIRGUARD_SECRETS_H
#define AIRGUARD_SECRETS_H

#define AIRGUARD_WIFI_SSID     "your-hotspot-name"
#define AIRGUARD_WIFI_PASSWORD "your-hotspot-password"

#endif
